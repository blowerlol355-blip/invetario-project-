# StockPilot - Variables de entorno
# Copia este archivo como .env y ajusta los valores.
# Las variables se validan con Zod al arrancar (src/lib/env.ts).

# Entorno de Node (development | test | production)
NODE_ENV=development

# -- Base de datos (PostgreSQL en Supabase) ---------------------------
# Cadena de conexion usada por Prisma (cliente y migraciones). En tu equipo usa el
# "Session pooler" de Supabase (puerto 5432). Ver docs/DEPLOY.md.
# Formato: postgresql://postgres.REF:CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.REF:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
# Solo en Vercel: DATABASE_URL apunta al "Transaction pooler" (puerto 6543) y DIRECT_URL al
# "Session pooler" (5432) para que las migraciones no pasen por el pooler de transacciones.
# DIRECT_URL="postgresql://postgres.REF:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Zona horaria del negocio (IANA) para los cortes de fecha; en Vercel los servidores usan UTC
# y no permiten definir TZ, por eso se usa este nombre (se aplica en src/instrumentation.ts).
# APP_TIMEZONE=America/Caracas

# -- Autenticacion (Auth.js) ---------------------------------------
# Secreto para firmar los JWT. Genera uno con: npx auth secret
# o con: openssl rand -base64 32
AUTH_SECRET=cambia-este-secreto-por-uno-aleatorio-de-al-menos-32-caracteres
# URL publica de la app (opcional en desarrollo)
AUTH_URL=http://localhost:3000

# -- Opcionales ----------------------------------------------------
# Omite la validacion de variables (util en CI para "next build" sin BD)
# SKIP_ENV_VALIDATION=true
