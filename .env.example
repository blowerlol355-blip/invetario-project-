# StockPilot - Variables de entorno
# Copia este archivo como .env y ajusta los valores.
# Las variables se validan con Zod al arrancar (src/lib/env.ts).

# Entorno de Node (development | test | production)
NODE_ENV=development

# -- Base de datos (SQL Server 2022) --------------------------------
# Cadena de conexion usada por Prisma (migraciones y cliente).
# Formato: sqlserver://HOST:PUERTO;database=NOMBRE;user=USUARIO;password=CLAVE;encrypt=true;trustServerCertificate=true
# El usuario debe poder crear bases de datos (Prisma usa una "shadow database" en desarrollo).
# Crea la base con: npm run db:create
DATABASE_URL="sqlserver://localhost:1433;database=stockpilot;user=sa;password=TuClaveSegura_123!;encrypt=true;trustServerCertificate=true"
# Azure SQL Database (produccion en Vercel, ver docs/DEPLOY.md): certificado valido, sin trustServerCertificate
# DATABASE_URL="sqlserver://stockpilot-sql.database.windows.net:1433;database=stockpilot;user=USUARIO;password=CLAVE;encrypt=true"

# Zona horaria del negocio para los cortes de fecha (en Vercel los servidores usan UTC)
# TZ=America/Caracas

# -- Autenticacion (Auth.js) ---------------------------------------
# Secreto para firmar los JWT. Genera uno con: npx auth secret
# o con: openssl rand -base64 32
AUTH_SECRET=cambia-este-secreto-por-uno-aleatorio-de-al-menos-32-caracteres
# URL publica de la app (opcional en desarrollo)
AUTH_URL=http://localhost:3000

# -- Opcionales ----------------------------------------------------
# Omite la validacion de variables (util en CI para "next build" sin BD)
# SKIP_ENV_VALIDATION=true
